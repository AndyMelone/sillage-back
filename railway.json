{
  "$schema": "https://railway.com/static/railway-service.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "corepack enable && yarn build && cd .medusa/server && yarn install --immutable"
  },
  "deploy": {
    "startCommand": "cd .medusa/server && yarn start",
    "restartPolicyType": "ON_FAILURE",
    "numReplicas": 1
  }
}
